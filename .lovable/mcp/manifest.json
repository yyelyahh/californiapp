{
  "version": 1,
  "sdk_version": "2.0.4",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qojybnnwxmxmqahmjxiy.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "california",
      "version": "0.1.0",
      "title": "California"
    },
    "tools": [
      {
        "name": "list_inventory",
        "title": "Consultar estoque",
        "description": "Lista o estoque da casa (marca, modelo, sabor, preço de venda e quantidade), com filtros opcionais por marca/modelo/sabor e por estoque baixo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "brand": {
              "type": "string",
              "description": "Filtra pela marca (busca parcial)."
            },
            "model": {
              "type": "string",
              "description": "Filtra pelo modelo (busca parcial)."
            },
            "flavor": {
              "type": "string",
              "description": "Filtra pelo sabor (busca parcial)."
            },
            "only_low_stock": {
              "type": "boolean",
              "description": "Se verdadeiro, retorna apenas itens com estoque igual ou abaixo do mínimo."
            },
            "limit": {
              "type": "integer",
              "description": "Máximo de linhas (padrão 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "seller_stock",
        "title": "Estoque com vendedores",
        "description": "Mostra quanto de cada produto está atribuído a cada vendedor (consignação), opcionalmente filtrado por vendedor.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "seller_name": {
              "type": "string",
              "description": "Filtra por nome do vendedor (busca parcial)."
            },
            "limit": {
              "type": "integer",
              "description": "Máximo de linhas (padrão 200)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_pending_orders",
        "title": "Pedidos pendentes",
        "description": "Lista os pedidos feitos pelo catálogo que ainda aguardam confirmação, com cliente, vendedor, valor e itens.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "description": "Máximo de pedidos (padrão 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "sales_summary",
        "title": "Resumo de vendas",
        "description": "Resumo das vendas em um período: quantidade de vendas, unidades, receita total, valor já recebido e valor em aberto.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "description": "Data inicial no formato AAAA-MM-DD."
            },
            "end_date": {
              "type": "string",
              "description": "Data final no formato AAAA-MM-DD (inclusiva)."
            },
            "seller_name": {
              "type": "string",
              "description": "Filtra por nome do vendedor (busca parcial)."
            }
          },
          "required": [
            "start_date",
            "end_date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
